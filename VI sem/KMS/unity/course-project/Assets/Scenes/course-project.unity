  m_text: "\u041F\u0440\u0430\u0432\u0438\u043B\u0430 \u0440\u0430\u0431\u043E\u0442\u044B
    \u0441 \u0441\u0438\u043C\u0443\u043B\u044F\u0442\u043E\u0440\u043E\u043C:\r\n1.
    \u041D\u0430\u0432\u0435\u0434\u0438\u0442\u0435 \u043A\u0443\u0440\u0441\u043E\u0440
    \u043D\u0430 \u043A\u043D\u043E\u043F\u043A\u0443 \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u0430
    \u0434\u043B\u044F \u043F\u0440\u043E\u0441\u043C\u043E\u0442\u0440\u0430 \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u0438.\r\n2.
    \u041D\u0430\u0436\u043C\u0438\u0442\u0435 \u043D\u0430 \u043A\u043D\u043E\u043F\u043A\u0443
    \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u0430 \u0434\u043B\u044F \u043F\u0435\u0440\u0435\u043C\u0435\u0449\u0435\u043D\u0438\u044F
    \u043A\u0430\u043C\u0435\u0440\u044B.\r\n3. \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435
    \u043A\u043D\u043E\u043F\u043A\u0443 \u041F\u0440\u0430\u043A\u0442\u0438\u043A\u0430
    \u0434\u043B\u044F \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u044F
    \u0437\u0430\u0434\u0430\u043D\u0438\u0439."
