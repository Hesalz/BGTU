  lebedkaInfo: "\u041B\u0435\u0431\u0451\u0434\u043A\u0430 - \u0433\u0438\u0434\u0440\u0430\u0432\u043B\u0438\u0447\u0435\u0441\u043A\u043E\u0435
    \u0442\u044F\u0433\u043E\u0432\u043E\u0435 \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u043E
    \u0441 \u0442\u0440\u043E\u0441\u043E\u043C \u0438 \u043A\u0440\u044E\u043A\u043E\u043C
    \u0434\u043B\u044F \u043F\u043E\u0434\u0442\u044F\u0433\u0438\u0432\u0430\u043D\u0438\u044F
    \u0430\u0432\u0442\u043E\u043C\u043E\u0431\u0438\u043B\u044F \u043D\u0430 \u043F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u0443
    \u044D\u0432\u0430\u043A\u0443\u0430\u0442\u043E\u0440\u0430."
  shassiInfo: "\u0428\u0430\u0441\u0441\u0438 - \u0433\u0440\u0443\u0437\u043E\u0432\u0430\u044F
    \u043F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u0430 \u043D\u0430 \u043A\u043E\u043B\u0451\u0441\u043D\u043E\u0439
    \u0431\u0430\u0437\u0435 \u044D\u0432\u0430\u043A\u0443\u0430\u0442\u043E\u0440\u0430.
    \u041E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u0435\u0442 \u0442\u0440\u0430\u043D\u0441\u043F\u043E\u0440\u0442\u0438\u0440\u043E\u0432\u043A\u0443
    \u044D\u0432\u0430\u043A\u0443\u0438\u0440\u0443\u0435\u043C\u043E\u0433\u043E
    \u0430\u0432\u0442\u043E\u043C\u043E\u0431\u0438\u043B\u044F."
  migalkaInfo: "\u041C\u0438\u0433\u0430\u043B\u043A\u0430 - \u0441\u0432\u0435\u0442\u043E\u0432\u043E\u0439
    \u0441\u0438\u0433\u043D\u0430\u043B\u044C\u043D\u044B\u0439 \u043C\u0430\u044F\u0447\u043E\u043A
