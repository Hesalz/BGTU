# SQL Server
MSSQL_SA_PASSWORD=Replace_With_Strong_SQL_Password_123!
MSSQL_DATABASE=PCConfigurator

# API database connection
DB_HOST=sqlserver
DB_PORT=1433
DB_USERNAME=sa
DB_PASSWORD=Replace_With_Strong_SQL_Password_123!
DB_DATABASE=PCConfigurator
DB_SYNCHRONIZE=true

# Authentication — replace the development secret before use
JWT_SECRET=Replace_With_A_Long_Random_Secret

# Optional initial administrator. Set both values to create/promote this account.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Replace_With_Strong_Admin_Password_123!

# Frontend
WEB_PORT=5173
