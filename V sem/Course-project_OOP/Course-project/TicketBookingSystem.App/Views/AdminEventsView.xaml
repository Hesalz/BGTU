<UserControl x:Class="TicketBookingSystem.App.Views.AdminEventsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="1000">
    <Grid Background="{StaticResource BackgroundColor}">
        <Grid Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Список мероприятий -->
            <StackPanel Grid.Column="0" Margin="0,0,20,0">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                    <Button Content="← Назад" 
                           Command="{Binding BackCommand}" 
                           Style="{StaticResource SecondaryButtonStyle}"
                           Margin="0,0,10,0"/>
                    <Button Content="➕ Новое мероприятие" Command="{Binding NewEventCommand}"/>
                </StackPanel>
                
                <Border Style="{StaticResource ModernCardStyle}" Height="500">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ListBox ItemsSource="{Binding Events}" 
                                SelectedItem="{Binding SelectedEvent}" 
                                BorderThickness="0"
                                Background="Transparent"
                                ItemContainerStyle="{StaticResource ModernListBoxItemStyle}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource CardBackgroundColor}"
                                           BorderBrush="{StaticResource BorderColor}"
                                           BorderThickness="1"
                                           CornerRadius="12"
                                           Padding="16"
                                           Margin="0,0,0,12">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#000000" BlurRadius="4" ShadowDepth="2" Opacity="0.1"/>
                                        </Border.Effect>
                                        <StackPanel>
                                            <Border Height="120" 
                                                   CornerRadius="8" 
                                                   ClipToBounds="True"
                                                   Margin="0,0,0,12">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding PrimaryPhoto}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Image Source="{Binding PrimaryPhoto, Converter={StaticResource ByteArrayToImageSourceConverter}}"
                                                       Height="120" 
                                                       Stretch="UniformToFill"/>
                                            </Border>
                                            <TextBlock Text="{Binding Title}" 
                                                      FontSize="18" 
                                                      FontWeight="Bold"
                                                      Foreground="{StaticResource TextPrimaryColor}"
                                                      Margin="0,0,0,8"/>
                                            <TextBlock Text="{Binding Description}" 
                                                      TextWrapping="Wrap" 
                                                      Foreground="{StaticResource TextSecondaryColor}"
                                                      Margin="0,0,0,8"/>
                                            <TextBlock Text="{Binding Categories, Converter={StaticResource EventCategoryToDescriptionConverter}, StringFormat='🏷️ {0}'}" 
                                                      Foreground="{StaticResource PrimaryColor}"
                                                      FontWeight="Medium"
                                                      Margin="0,0,0,8"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock Text="📅 " Foreground="{StaticResource TextSecondaryColor}"/>
                                                <TextBlock Text="{Binding Date, StringFormat='{}{0:dd.MM.yyyy}'}" 
                                                          Foreground="{StaticResource TextSecondaryColor}"/>
                                                <TextBlock Text="  ⏰ " Foreground="{StaticResource TextSecondaryColor}" Margin="10,0,0,0"/>
                                                <TextBlock Text="{Binding Time, StringFormat='{}{0:hh\\:mm}'}" 
                                                          Foreground="{StaticResource TextSecondaryColor}"/>
                                                <TextBlock Text="  📍 " Foreground="{StaticResource TextSecondaryColor}" Margin="10,0,0,0"/>
                                                <TextBlock Text="{Binding Location}" 
                                                          Foreground="{StaticResource TextSecondaryColor}"/>
                                                <TextBlock Text="  💰 " Foreground="{StaticResource TextSecondaryColor}" Margin="10,0,0,0"/>
                                                <TextBlock Text="{Binding Price, StringFormat='{}{0:C}'}" 
                                                          Foreground="{StaticResource PrimaryColor}"
                                                          FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                </Border>
            </StackPanel>
            
            <!-- Форма редактирования -->
            <Border Grid.Column="1" Style="{StaticResource ModernCardStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Редактирование мероприятия" Style="{StaticResource SubtitleTextStyle}"/>
                        
                        <TextBlock Text="Название:" Style="{StaticResource LabelTextStyle}"/>
                        <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" 
                                Style="{StaticResource ModernTextBoxStyle}"
                                Margin="0,0,0,15"/>
                        
                        <TextBlock Text="Описание:" Style="{StaticResource LabelTextStyle}"/>
                        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" 
                                Style="{StaticResource ModernTextBoxStyle}"
                                TextWrapping="Wrap" AcceptsReturn="True" Height="80" Margin="0,0,0,15"/>
                        
                        <TextBlock Text="Дата:" Style="{StaticResource LabelTextStyle}"/>
                        <DatePicker SelectedDate="{Binding Date, Mode=TwoWay}" 
                                   Margin="0,0,0,15"
                                   FontSize="14"
                                   Height="40"
                                   VerticalContentAlignment="Center">
                            <DatePicker.Resources>
                                <Style TargetType="TextBox">
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                    <Setter Property="TextAlignment" Value="Center"/>
                                </Style>
                            </DatePicker.Resources>
                        </DatePicker>
                        
                        <TextBlock Text="Время (чч:мм):" Style="{StaticResource LabelTextStyle}"/>
                        <TextBox x:Name="TimeTextBox" 
                                Style="{StaticResource ModernTextBoxStyle}"
                                TextChanged="TimeTextBox_TextChanged" Margin="0,0,0,15"/>
                        
                        <TextBlock Text="Место:" Style="{StaticResource LabelTextStyle}"/>
                        <TextBox Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}" 
                                Style="{StaticResource ModernTextBoxStyle}"
                                Margin="0,0,0,15"/>
                        
                        <TextBlock Text="Количество билетов:" Style="{StaticResource LabelTextStyle}"/>
                        <TextBox Text="{Binding TotalTickets, UpdateSourceTrigger=PropertyChanged}" 
                                Style="{StaticResource ModernTextBoxStyle}"
                                Margin="0,0,0,15"/>
                        
                        <TextBlock Text="Цена:" Style="{StaticResource LabelTextStyle}"/>
                        <TextBox Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}" 
                                Style="{StaticResource ModernTextBoxStyle}"
                                IsEnabled="{Binding IsPriceLocked, Converter={StaticResource InverseBooleanConverter}}" 
                                Margin="0,0,0,5"/>
                        <TextBlock Text="{Binding PriceLockMessage}" 
                                  Foreground="{StaticResource WarningColor}" 
                                  TextWrapping="Wrap" 
                                  FontSize="12"
                                  Margin="0,0,0,15"
                                  Visibility="{Binding PriceLockMessage, Converter={StaticResource StringToVisibilityConverter}}"/>

                        <TextBlock Text="Фотогалерея:" Style="{StaticResource LabelTextStyle}"/>
                        <ItemsControl ItemsSource="{Binding PhotoGallery}" Margin="0,0,0,15">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,10,10">
                                        <Border Width="120" 
                                               Height="80" 
                                               BorderBrush="{StaticResource BorderColor}" 
                                               BorderThickness="2"
                                               CornerRadius="8"
                                               ClipToBounds="True">
                                            <Image Source="{Binding ImageData, Converter={StaticResource ByteArrayToImageSourceConverter}}"
                                                   Stretch="UniformToFill"/>
                                        </Border>
                                        <Button Command="{Binding DataContext.RemovePhotoCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                               CommandParameter="{Binding}"
                                               Width="24" 
                                               Height="24"
                                               HorizontalAlignment="Right" 
                                               VerticalAlignment="Top"
                                               Background="{StaticResource DangerColor}" 
                                               Foreground="White"
                                               BorderThickness="0"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Padding="0"
                                               Content="×"
                                               Cursor="Hand">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}"
                                                                       CornerRadius="12"
                                                                       Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="📷 Добавить фото" 
                               Command="{Binding AddPhotosCommand}" 
                               Style="{StaticResource SecondaryButtonStyle}"
                               Margin="0,0,0,20"/>

                        <TextBlock Text="Категории (выберите несколько):" Style="{StaticResource LabelTextStyle}"/>
                        <ItemsControl ItemsSource="{Binding CategoryOptions}" Margin="0,0,0,20">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding DisplayName}"
                                             IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <Button Content="💾 Сохранить" 
                                   Command="{Binding SaveEventCommand}" 
                                   Margin="0,0,10,0"
                                   HorizontalAlignment="Stretch"/>
                            <Button Content="🗑️ Удалить" 
                                   Command="{Binding DeleteEventCommand}" 
                                   Style="{StaticResource DangerButtonStyle}"
                                   HorizontalAlignment="Stretch"/>
                        </StackPanel>
                        
                        <TextBlock Text="{Binding ErrorMessage}" 
                                  Style="{StaticResource ErrorTextStyle}"
                                  Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>

