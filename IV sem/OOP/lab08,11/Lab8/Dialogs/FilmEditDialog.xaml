<Window x:Class="CinemaManagement.Dialogs.FilmEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CinemaManagement.Dialogs"
        mc:Ignorable="d"
        Title="{Binding Title}" Height="588" Width="614"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Image Grid.Row="0" Source="{Binding Film.PosterImage}" Width="150" Height="200" 
               HorizontalAlignment="Left" Margin="203,5,0,5"/>

        <Button Grid.Row="1" Content="Выбрать постер" Width="150" HorizontalAlignment="Center"
                Command="{Binding SelectPosterCommand}" Margin="0,0,0,10"/>

        <Label Grid.Row="2" Content="Название:"/>
        <TextBox Grid.Row="2" Text="{Binding Film.Title, UpdateSourceTrigger=PropertyChanged}" 
                 Margin="0,25,0,10"/>

        <Label Grid.Row="3" Content="Режиссер:"/>
        <TextBox Grid.Row="3" Text="{Binding Film.Director, UpdateSourceTrigger=PropertyChanged}" 
                 Margin="0,25,0,10"/>

        <Label Grid.Row="4" Content="Год выпуска:"/>
        <TextBox Grid.Row="4" Text="{Binding Film.ReleaseYear, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, NotifyOnValidationError=True}"
                 Margin="0,25,0,10"/>

        <Label Grid.Row="5" Content="Жанр:"/>
        <TextBox Grid.Row="5" Text="{Binding Film.Genre, UpdateSourceTrigger=PropertyChanged}" 
                 Margin="0,25,0,10"/>

        <Label Grid.Row="6" Content="Длительность (мин):"/>
        <TextBox Grid.Row="6" Text="{Binding Film.Duration, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, NotifyOnValidationError=True}"
                 Margin="0,25,0,10"/>

        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" Width="80" Margin="5" IsDefault="True" 
                    Command="{Binding SaveCommand}" 
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                    IsEnabled="{Binding CanSave}"/>
            <Button Content="Отмена" Width="80" Margin="5" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
