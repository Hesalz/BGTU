<!-- LightTheme.xaml -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Основные цвета -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="ForegroundBrush" Color="#FF000000"/>
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#FFF3F3F3"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#FFCCCCCC"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#FF0078D7"/>

    <!-- Дополнительные цвета для AdminPanel -->
    <SolidColorBrush x:Key="MenuBackground" Color="#FFA52A2A"/>
    <SolidColorBrush x:Key="MenuForeground" Color="White"/>
    <SolidColorBrush x:Key="SecondaryBackground" Color="#FFE0E0E0"/>
    <SolidColorBrush x:Key="TextColor" Color="#FF333333"/>
    <SolidColorBrush x:Key="SecondaryTextColor" Color="#FF666666"/>
    <SolidColorBrush x:Key="HighlightBrush" Color="#e57e00"/>
    <SolidColorBrush x:Key="DarkRed" Color="#FF8B0000"/>
    <SolidColorBrush x:Key="LightRed" Color="#FFA52A2A"/>
    <SolidColorBrush x:Key="SelectedItemBackground" Color="#972D2D"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#FFE1E1E1"/>
    <SolidColorBrush x:Key="RadBut" Color="#FF000000"/>
</ResourceDictionary>