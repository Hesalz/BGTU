<UserControl x:Class="TicketBookingSystem.App.Views.EventsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:TicketBookingSystem.ViewModels.ViewModels"
             xmlns:views="clr-namespace:TicketBookingSystem.App.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <Style x:Key="IconToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#1f5bff"/>
                    <Setter Property="BorderBrush" Value="#1f5bff"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="280" Margin="0,0,10,0">
                        <TextBox Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource ModernTextBoxStyle}" 
                                VerticalContentAlignment="Center"
                                x:Name="SearchTextBox"/>
                        <TextBlock Text="Поиск мероприятий..." 
                                  Foreground="{StaticResource TextSecondaryColor}"
                                  VerticalAlignment="Center"
                                  Margin="12,0,0,0"
                                  IsHitTestVisible="False"
                                  Visibility="{Binding Text, ElementName=SearchTextBox, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=Inverse}"/>
                    </Grid>
                    <Button Content="Поиск" Command="{Binding SearchCommand}" Padding="15,5"/>
                    
                    <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Сортировка:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,8,0"/>
                        <Button Command="{Binding SetSortOptionCommand}" 
                               CommandParameter="{x:Static vm:EventSortOption.DateAsc}" 
                               Content="📅 ↑"
                               Padding="12,8"
                               Margin="0,0,5,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedSortOption}" Value="DateAsc">
                                            <Setter Property="Background" Value="{StaticResource PrimaryColor}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Command="{Binding SetSortOptionCommand}" 
                               CommandParameter="{x:Static vm:EventSortOption.DateDesc}" 
                               Content="📅 ↓"
                               Padding="12,8">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedSortOption}" Value="DateDesc">
                                            <Setter Property="Background" Value="{StaticResource PrimaryColor}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <Button x:Name="CategoryToggle"
                           Content="{Binding CategoryFilterSummary, StringFormat='🏷️ {0}'}"
                           Click="CategoryToggle_Click"
                           Style="{StaticResource SecondaryButtonStyle}"
                           Margin="20,0,0,0"
                           Padding="15,8"/>

                    <StackPanel Orientation="Horizontal" Margin="20,0,0,0">
                        <Button Command="{Binding SetViewModeCommand}" 
                               CommandParameter="List" 
                               Content="📋 Список"
                               Padding="12,8"
                               Margin="0,0,5,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsGridView}" Value="False">
                                            <Setter Property="Background" Value="{StaticResource PrimaryColor}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Command="{Binding SetViewModeCommand}" 
                               CommandParameter="Grid" 
                               Content="⊞ Сетка"
                               Padding="12,8">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsGridView}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource PrimaryColor}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="1" Content="Личный кабинет" 
                        Click="ProfileButton_Click"
                        Padding="20,5" Margin="10,0,0,0"/>
            </Grid>

            <Popup PlacementTarget="{Binding ElementName=CategoryToggle}"
                   Placement="Bottom"
                   StaysOpen="False"
                   IsOpen="{Binding IsCategoryFilterOpen, Mode=TwoWay}">
                <Border Background="White" BorderBrush="#CCCCCC" BorderThickness="1" Padding="15" CornerRadius="6" >
                    <StackPanel>
                        <TextBlock Text="Категории" FontWeight="Bold" Margin="0,0,0,10"/>
                        <ItemsControl ItemsSource="{Binding CategoryFilters}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding DisplayName}"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              Margin="0,0,10,5"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="Сбросить фильтры" Command="{Binding ClearCategoryFiltersCommand}" Margin="0,10,0,0" Padding="10,5"/>
                    </StackPanel>
                </Border>
            </Popup>

            <Border BorderBrush="#DDD" BorderThickness="1" Padding="10" Margin="0,10,0,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RecommendedEvent}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="Рекомендованное мероприятие" FontWeight="Bold" FontSize="16"/>
                    <ContentControl Content="{Binding RecommendedEvent}">
                        <ContentControl.ContentTemplate>
                            <DataTemplate>
                                <Border BorderBrush="LightGray" BorderThickness="1" Padding="10" Margin="0,10,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="{Binding PrimaryPhoto, Converter={StaticResource ByteArrayToImageSourceConverter}}"
                                               Width="160" Height="100" Stretch="UniformToFill" Margin="0,0,10,0">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding PrimaryPhoto}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" MaxWidth="400"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                <TextBlock Text="Дата: " FontWeight="Bold"/>
                                                <TextBlock Text="{Binding Date, StringFormat='{}{0:dd.MM.yyyy}'}"/>
                                                <TextBlock Text=" Время: " FontWeight="Bold" Margin="10,0,0,0"/>
                                                <TextBlock Text="{Binding Time, StringFormat='{}{0:hh\\:mm}'}"/>
                                            </StackPanel>
                                            <Button Content="Подробнее" Command="{Binding DataContext.OpenRecommendedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    Margin="0,10,0,0" Padding="15,5" Width="150"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                </StackPanel>
            </Border>
        </StackPanel>
        
        <Grid Grid.Row="1">
            <ListBox ItemsSource="{Binding Events}" 
                    SelectedItem="{Binding SelectedEvent}"
                    ItemContainerStyle="{StaticResource ModernListBoxItemStyle}"
                    Visibility="{Binding IsGridView, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource CardBackgroundColor}"
                               BorderBrush="{StaticResource BorderColor}"
                               BorderThickness="1"
                               CornerRadius="12"
                               Padding="16"
                               Margin="0,0,0,12"
                               HorizontalAlignment="Center"
                               MaxWidth="900">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="250" 
                                       Height="180" 
                                       CornerRadius="8" 
                                       ClipToBounds="True"
                                       Margin="0,0,16,0"
                                       Background="{StaticResource BackgroundColor}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PrimaryPhoto}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Image Source="{Binding PrimaryPhoto, Converter={StaticResource ByteArrayToImageSourceConverter}}"
                                           Width="250"
                                           Height="180" 
                                           Stretch="UniformToFill"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center" Width="600">
                                    <TextBlock Text="{Binding Title}" 
                                              FontSize="18" 
                                              FontWeight="Bold"
                                              Foreground="{StaticResource TextPrimaryColor}"
                                              Margin="0,0,0,8"/>
                                    <TextBlock Text="{Binding Description}" 
                                              TextWrapping="Wrap" 
                                              Foreground="{StaticResource TextSecondaryColor}"
                                              MaxHeight="60"
                                              TextTrimming="CharacterEllipsis"
                                              Margin="0,0,0,8"/>
                                    <TextBlock Text="{Binding Categories, Converter={StaticResource EventCategoryToDescriptionConverter}, StringFormat='🏷️ {0}'}" 
                                              Foreground="{StaticResource PrimaryColor}"
                                              FontWeight="Medium"
                                              Margin="0,0,0,8"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,10">
                                        <TextBlock Text="📅 " Foreground="{StaticResource TextSecondaryColor}"/>
                                        <TextBlock Text="{Binding Date, StringFormat='{}{0:dd.MM.yyyy}'}" 
                                                  Foreground="{StaticResource TextSecondaryColor}"/>
                                        <TextBlock Text="  ⏰ " Foreground="{StaticResource TextSecondaryColor}" Margin="10,0,0,0"/>
                                        <TextBlock Text="{Binding Time, StringFormat='{}{0:hh\\:mm}'}" 
                                                  Foreground="{StaticResource TextSecondaryColor}"/>
                                        <TextBlock Text="  📍 " Foreground="{StaticResource TextSecondaryColor}" Margin="10,0,0,0"/>
                                        <TextBlock Text="{Binding Location}" 
                                                  Foreground="{StaticResource TextSecondaryColor}"/>
                                        <TextBlock Text="  💰 " Foreground="{StaticResource TextSecondaryColor}" Margin="10,0,0,0"/>
                                        <TextBlock Text="{Binding Price, StringFormat='{}{0:C}'}" 
                                                  Foreground="{StaticResource PrimaryColor}"
                                                  FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <Button Content="🎫 Забронировать" 
                                           Command="{Binding DataContext.SelectEventCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           CommandParameter="{Binding}"
                                           Margin="0,5,0,0"
                                           HorizontalAlignment="Left"
                                           Padding="20,8"
                                           Width="200"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <ScrollViewer VerticalScrollBarVisibility="Auto" 
                         HorizontalScrollBarVisibility="Disabled"
                         CanContentScroll="False"
                         PanningMode="VerticalOnly"
                         Visibility="{Binding IsGridView, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ItemsControl ItemsSource="{Binding Events}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource CardBackgroundColor}"
                               BorderBrush="{StaticResource BorderColor}"
                               BorderThickness="1"
                               CornerRadius="12"
                               Margin="8"
                               Width="350">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="4" ShadowDepth="2" Opacity="0.1"/>
                            </Border.Effect>
                            <StackPanel>
                                <Border Height="200" 
                                       CornerRadius="12" 
                                       ClipToBounds="True"
                                       Margin="0,0,0,12"
                                       Background="{StaticResource BackgroundColor}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PrimaryPhoto}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Image Source="{Binding PrimaryPhoto, Converter={StaticResource ByteArrayToImageSourceConverter}}"
                                           Height="200" 
                                           Stretch="UniformToFill"/>
                                </Border>
                                <StackPanel Margin="12">
                                    <TextBlock Text="{Binding Title}" 
                                              FontWeight="Bold" 
                                              FontSize="16" 
                                              TextWrapping="Wrap" 
                                              Foreground="{StaticResource TextPrimaryColor}"
                                              Margin="0,0,0,8"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                        <TextBlock Text="📅 " Foreground="{StaticResource TextSecondaryColor}"/>
                                        <TextBlock Text="{Binding Date, StringFormat='{}{0:dd.MM.yyyy}'}" 
                                                  Foreground="{StaticResource TextSecondaryColor}"/>
                                        <TextBlock Text="  ⏰ " Foreground="{StaticResource TextSecondaryColor}" Margin="8,0,0,0"/>
                                        <TextBlock Text="{Binding Time, StringFormat='{}{0:hh\\:mm}'}" 
                                                  Foreground="{StaticResource TextSecondaryColor}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Location}" 
                                              TextWrapping="Wrap" 
                                              Foreground="{StaticResource TextSecondaryColor}"
                                              Margin="0,0,0,8"/>
                                    <TextBlock Text="{Binding Price, StringFormat='{}{0:C}'}" 
                                              FontWeight="Bold" 
                                              FontSize="18" 
                                              Foreground="{StaticResource PrimaryColor}"
                                              Margin="0,5,0,10"/>
                                    <Button Content="🎫 Забронировать" 
                                           Command="{Binding DataContext.SelectEventCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           CommandParameter="{Binding}"
                                           Margin="0,5,0,0"
                                           HorizontalAlignment="Stretch"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
        
        <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" 
                   Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"
                   Grid.Row="1" VerticalAlignment="Top" Margin="10"/>
    </Grid>
</UserControl>

